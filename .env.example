APP_NAME=AI Knowledge Base API
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS\n# Set true when the API is served over HTTPS.\nREFRESH_TOKEN_COOKIE_SECURE=false
# Required only when upgrading a database that already contains documents.
MIGRATION_OWNER_EMAIL=
MIGRATION_OWNER_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5434/knowledge_base
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
