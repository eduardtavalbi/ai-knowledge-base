APP_NAME=AI Knowledge Base API
DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET_KEY=CHANGE_ME_USE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Set true when the API is served over HTTPS.
REFRESH_TOKEN_COOKIE_SECURE=false
# Comma-separated browser origins allowed to use the API and refresh cookie.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_PUBLIC_URL=http://localhost:5173
# Enable in production after configuring SMTP delivery.
EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
# Required only when upgrading a database that already contains documents.
MIGRATION_OWNER_EMAIL=
MIGRATION_OWNER_PASSWORD=
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5434/knowledge_base
POSTGRES_DB=knowledge_base
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.8-flash
